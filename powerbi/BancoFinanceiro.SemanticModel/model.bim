        "lineageTag": "3f61b391-b749-4709-b8eb-7b9f08373146",
        "measures": [
          {
            "name": "Total Contratos",
            "expression": [
              "",
              "DISTINCTCOUNT('public vw_emprestimos'[id_emprestimo])"
            ],
            "formatString": "0",
            "lineageTag": "aab7033c-d33f-4202-9341-e8b434c29b23"
          },
          {
            "name": "Principal Contratado",
            "expression": [
              "",
              "SUM('public vw_emprestimos'[principal_brl])"
            ],
            "formatString": "\"R$ \"#,0.00",
            "lineageTag": "4dd8106c-1a04-49c2-a124-68c5c58b8ddc"
          },
          {
            "name": "Contratos em Atraso",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Contratos],",
              "    'public vw_emprestimos'[status_contrato] = \"Em atraso\"",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "0b80afab-b802-494c-990e-0f2ec42aa408"
          },
          {
            "name": "% Contratos em Atraso",
            "expression": [
              "",
              "DIVIDE(",
              "    [Contratos em Atraso],",
              "    [Total Contratos],",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "4ca1b7a8-593a-4298-ade2-537539a449f6"
          },
          {
            "name": "Principal de Contratos em Atraso",
            "expression": [
              "",
              "CALCULATE(",
              "    [Principal Contratado],",
              "    'public vw_emprestimos'[status_contrato] = \"Em atraso\"",
              ")"
            ],
            "formatString": "\"R$ \"#,0.00",
            "lineageTag": "0bbadee4-fa1c-464c-9105-e3526fe0e5a4"
          },
          {
            "name": "% Principal de Contratos em Atraso",
            "expression": [
              "",
              "DIVIDE(",
              "    [Principal de Contratos em Atraso],",
              "    [Principal Contratado],",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "277c4678-dbe0-46af-8b5c-5aeb5cb2fb26"
          },
          {
            "name": "Principal Medio por Contrato",
            "expression": [
              "",
              "DIVIDE(",
              "    [Principal Contratado],",
              "    [Total Contratos],",
              "    0",
              ")"
            ],
            "formatString": "\"R$ \"#,0.00",
            "lineageTag": "931ce8ca-fa5a-4137-aad6-4676eb696184"
          },
          {
            "name": "Principal Contratado (mi)",
            "displayFolder": "Dashboard",
            "expression": "DIVIDE([Principal Contratado], 1000000)",
            "formatString": "\"R$ \"0.00\" mi\"",
            "lineageTag": "da28cca9-e8eb-4c6a-a856-add713e36ce3"
          },
          {
            "name": "Detalhe Contratos em Atraso",
            "displayFolder": "Dashboard",
            "expression": "FORMAT([Contratos em Atraso], \"0\") & \" de \" & FORMAT([Total Contratos], \"0\") & \" contratos\"",
            "lineageTag": "67599b61-13d4-4b02-ace5-41c1d13914cd"
          },
          {
            "name": "Participação Veículo",
            "displayFolder": "Dashboard",
            "expression": "DIVIDE(CALCULATE([Principal Contratado], KEEPFILTERS('public vw_emprestimos'[tipo_emprestimo] = \"Veículo\")), CALCULATE([Principal Contratado], ALLSELECTED('public vw_emprestimos'[tipo_emprestimo])))",
            "formatString": "0.00%",
            "lineageTag": "59fc1b42-390e-424d-a62f-dbdea17c77f5"
          },
          {
            "name": "Nota Concentração Veículo",
            "displayFolder": "Dashboard",
            "expression": "\"Veículo concentra \" & FORMAT([Participação Veículo], \"0.00%\") & \" do principal\"",
            "lineageTag": "5db0192f-ec44-4c99-9145-666b955d3e33"
          }
        ],
